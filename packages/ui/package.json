  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
